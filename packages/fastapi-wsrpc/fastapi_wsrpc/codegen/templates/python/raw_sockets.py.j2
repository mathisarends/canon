{% endfor %}


type RawMessageType = Literal["text", "binary"]
type RawMessage = str | bytes


@dataclass(frozen=True, slots=True)
class RawSocketEndpoint:
    name: RawSocketName
    url: str
    message_types: tuple[RawMessageType, ...] = ("text", "binary")
    subprotocols: tuple[str, ...] = ()


@dataclass(frozen=True, slots=True)
class RawSocketInfo:
    """One declared raw socket, before its variables are filled in."""

    name: RawSocketName
    url: str
    message_types: tuple[RawMessageType, ...] = ("text", "binary")
    subprotocols: tuple[str, ...] = ()
    variables: Mapping[str, RpcServerVariable] = field(default_factory=dict)

    def __post_init__(self) -> None:
        object.__setattr__(self, "variables", MappingProxyType(dict(self.variables)))


def resolve_raw_socket_endpoint(
    socket: RawSocketInfo,
    connected: Mapping[str, str] | None = None,
    values: Mapping[str, str | None] | None = None,
) -> RawSocketEndpoint:
    """Fill a socket URL from the call's values, then the client's connect values."""
    supplied = {
        **{
            name: value
            for name, value in (connected or {}).items()
            if name in socket.variables
        },
        **{name: value for name, value in (values or {}).items() if value is not None},
    }
    return RawSocketEndpoint(
        name=socket.name,
        url=resolve_url_template(
            f"raw socket {socket.name.value!r}",
            socket.url,
            socket.variables,
            supplied,
        ),
        message_types=socket.message_types,
        subprotocols=socket.subprotocols,
    )


class RawSocketTransport(Protocol):
    """Receives ``RpcStreamClosed`` once the server closed the socket normally."""

    async def receive(self) -> RawMessage: ...

    async def send(self, message: RawMessage) -> None: ...

    async def close(self) -> None: ...


type RawSocketOpener = Callable[[RawSocketEndpoint], Awaitable[RawSocketTransport]]


class RawSocket:
    """Sends and receives text (``str``) and binary (``bytes``) messages as-is."""

    def __init__(
        self, transport: RawSocketTransport, endpoint: RawSocketEndpoint
    ) -> None:
        self._transport = transport
        self.endpoint = endpoint

    async def receive(self) -> RawMessage:
        return await self._transport.receive()

    def __aiter__(self) -> Self:
        return self

    async def __anext__(self) -> RawMessage:
        try:
            return await self.receive()
        except RpcStreamClosed:
            raise StopAsyncIteration from None

    async def send(self, message: str | bytes | bytearray | memoryview) -> None:
        """Send one message; ``str`` is sent as text, bytes as binary."""
        if isinstance(message, str):
            message_type: RawMessageType = "text"
        elif isinstance(message, bytes | bytearray | memoryview):
            message_type = "binary"
            message = bytes(message)
        else:
            raise TypeError("RawSocket.send() expects str or bytes")
        if message_type not in self.endpoint.message_types:
            raise TypeError(
                f"The raw socket {self.endpoint.name.value!r} does not accept "
                f"{message_type} messages"
            )
        await self._transport.send(message)

    async def close(self) -> None:
        await self._transport.close()

    async def __aenter__(self) -> Self:
        return self

    async def __aexit__(self, *args: object) -> None:
        await self.close()


@asynccontextmanager
async def open_raw_socket(
    endpoint: RawSocketEndpoint, opener: RawSocketOpener | None
) -> AsyncGenerator[RawSocket, None]:
    """Open a socket for one ``async with`` block and close it when it ends."""
    if opener is None:
        raise RpcStreamsUnavailableError(
            "No raw socket opener configured; pass raw_socket_opener=..."
        )
    async with RawSocket(await opener(endpoint), endpoint) as socket:
        yield socket
{% if with_websocket %}


class RawWebSocket(Protocol):
    async def recv(self) -> str | bytes: ...

    async def send(self, message: str | bytes) -> None: ...

    async def close(self) -> None: ...


class RawWebSocketFactory(Protocol):
    def __call__(
        self,
        url: str,
        *,
        subprotocols: list[str] | None,
        additional_headers: Mapping[str, str] | None,
    ) -> Awaitable[RawWebSocket]: ...


class RawWebSocketStream:
    def __init__(self, socket: RawWebSocket) -> None:
        self._socket = socket
        self._closed = False

    @classmethod
    async def open(
        cls,
        endpoint: RawSocketEndpoint,
        *,
        headers: Mapping[str, str] | None = None,
        socket_factory: RawWebSocketFactory | None = None,
    ) -> Self:
        if socket_factory is None:
            try:
                from websockets.asyncio.client import connect
            except ImportError as error:
                raise RuntimeError(
                    "Generated WebSocket clients require the 'websockets' package"
                ) from error
            socket_factory = connect
        socket = await socket_factory(
            endpoint.url,
            subprotocols=list(endpoint.subprotocols) or None,
            additional_headers=headers,
        )
        return cls(socket)

    async def receive(self) -> RawMessage:
        if self._closed:
            raise RpcStreamClosed("The raw socket is closed")
        try:
            return await self._socket.recv()
        except Exception as error:
            self._raise_closed(error)
            raise

    async def send(self, message: RawMessage) -> None:
        if self._closed:
            raise RpcStreamClosed("The raw socket is closed")
        try:
            await self._socket.send(message)
        except Exception as error:
            self._raise_closed(error)
            raise

    async def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        await self._socket.close()

    def _raise_closed(self, error: Exception) -> None:
        try:
            from websockets.exceptions import ConnectionClosed, ConnectionClosedOK
        except ImportError:
            return
        if not isinstance(error, ConnectionClosed):
            return
        self._closed = True
        if isinstance(error, ConnectionClosedOK):
            raise RpcStreamClosed("The server closed the raw socket") from None
        close = error.rcvd
        code = 1006 if close is None else close.code
        reason = "" if close is None else close.reason
        failure = RpcStreamRefused if code == 1008 else RpcStreamFailed
        raise failure(code, reason) from error
